 </properties>
 <events>
  <script name="ScopeLib" isEscaped="1"><![CDATA[#uses &quot;lbTrending/lbTrending.ctl&quot;
//#uses &quot;lbWeb/lbWeb.ctl&quot;

mapping IdList;
mapping TypeIdList;
int InternalDpState = 0;

int PLOT_ELEMENTS = 1;
int PLOT_DPS = 2;
int PLOT_SINGLE = 3;
int PLOT_ALL = 4;

treeInit()
{

  myTree.addColumn(&quot;Column One&quot;);
  myTree.addColumn(&quot;Column Two&quot;);
  myTree.showHeader(FALSE);
  myTree.selectionMode(&quot;Extended&quot;);

  treeRefresh();
}

treeRefresh(int internal = 0)
{
  dyn_string syss, types, dpels;
  int i, j;
  string dp;

  myTree.clear();
  InternalDpState = internal;
  syss =  getSystems();
  dynSortAsc(syss);
  for(i = 1; i &lt;= dynlen(syss); i++)
  {
    syss[i] += &quot;:&quot;;
    myTree.appendItem(&quot;&quot;, syss[i], syss[i]);
    myTree.appendItem(syss[i], syss[i]+&quot;_Template&quot;, &quot;Template&quot;);
  }
}

treeClicked(string id, int column)
{
  if(column != 1)
    return;
  if(!IdList[id])
  {
    IdList[id] = 1;
    myTree.setIcon(id,1, &quot;16_ack_check_green_border.gif&quot;);
  }
  else
  {
    IdList[id] = 0;
    myTree.setIcon(id,1, &quot;16_ack_check_border1.gif&quot;);
  }
}

treeRightClicked(string id, int column)
{
  dyn_string items;

  if($1 == &quot;Trending&quot;)
  {
    trendingRightClick(id);
    return;
  }
  items = strsplit(id,&quot;:.&quot;);
  if(dynlen(items) &gt; 2)
    return;
//  if($1 == &quot;Trending&quot;)
//    trendingRightClick(id);
//  else
    webRightClick(id);
}

mapping TypeStructs;

expandOneLevel(string type, string id)
{
  int i, j;
  dyn_dyn_string partDef;
  dyn_string dpels, types;
  dyn_string parts, items, ids;
  string newid, topid;
  int child_done = 0;

  if(mappingHasKey(TypeIdList,type))
    ids = TypeIdList[type];
  partDef = TypeStructs[type];
  dpels = partDef[1];
  types = partDef[2];
  items = strsplit(id,&quot;.&quot;);
    for(i = 1; i &lt;= dynlen(dpels); i++)
    {
      if(!(strpos(dpels[i],id+&quot;.&quot;) == 0))
        continue;
      if(dpels[i] == id)
        continue;
      parts = strsplit(dpels[i],&quot;.&quot;);
      if(dynlen(parts) != (dynlen(items) + 1))
      {
        if(child_done)
          continue;
        else
          child_done++;
      }
      else
        child_done = 0;
      newid = id;
      topid = id;
//DebugN(&quot;test&quot;, id, dynlen(items), dpels[i]);
      for(j = (dynlen(items) + 1); j &lt;= dynlen(parts); j++)
      {
        newid = newid+&quot;.&quot;+parts[j];
        if(!myTree.itemExists(newid))
        {
          myTree.appendItem(topid,newid,&quot;.&quot;+parts[j]);
          myTree.setIcon(newid,0,types[i]);
//          if(j == dynlen(parts))
          if(types[i]!= &quot;dptree/struct.png&quot;)
          {
            IdList[newid] = 0;
            dynAppend(ids, newid);
            TypeIdList[type] = ids;
            myTree.setIcon(newid,1, &quot;16_ack_check_border1.gif&quot;);
          }
//          DebugN(&quot;Appending&quot;, topid, newid, &quot;.&quot;+parts[j], types[i]);
        }
        topid = newid;
      }
    }
}

treeExpanded(string id)
{
  dyn_string items, dpels, types, parts, dps, ids, elitems;
  string dpType, sys, newid, topid, pattern, dp, type;
  int i, j;
  mapping typeStruct;
  dyn_dyn_string partDef;

//  DebugN(&quot;expanded&quot;, id);

  items = strsplit(id,&quot;:.&quot;);


  if(dynlen(items) == 1)
  {
    if(myTree.itemExists(id+&quot;_Template&quot;))
      myTree.removeItem(id+&quot;_Template&quot;);
    sys = id;
    types = getDpTypes(sys, InternalDpState);
    for(j = 1; j &lt;= dynlen(types); j++)
    {
      if(!myTree.itemExists(sys+types[j]))
      {
        myTree.appendItem(sys, sys+types[j], types[j]);
        dp = getDpTypeDp(types[j], sys);
        if(dp != &quot;&quot;)
        {
          if(!myTree.itemExists(sys+types[j]+&quot;_Template&quot;))
          {
            myTree.appendItem(sys+types[j], sys+types[j]+&quot;_Template&quot;, &quot;Template&quot;);
          }
        }
      }
    }
  }
  else if(dynlen(items) == 2)
  {
    if(myTree.itemExists(id+&quot;_Template&quot;))
      myTree.removeItem(id+&quot;_Template&quot;);
    dpType = items[2];
    sys = items[1]+&quot;:&quot;;
    getDpTypeStruct(dpType, sys, dpels, types);
    elitems = strsplit(dpels[1],&quot;:.&quot;);
    dp = elitems[1];
    for(i = 1; i &lt;= dynlen(dpels); i++)
    {
      strreplace(dpels[i], dp, id);
    }
    partDef[1] = dpels;
    partDef[2] = types;
    TypeStructs[id] = partDef;
//DebugN(dpels, types);
    expandOneLevel(id, id);

/*
    for(i = 1; i &lt;= dynlen(dpels); i++)
    {
      parts = strsplit(dpels[i],&quot;.&quot;);
      newid = id;
      topid = id;
      for(j = 2; j &lt;= dynlen(parts); j++)
      {
        newid = newid+&quot;.&quot;+parts[j];
        if(!myTree.itemExists(newid))
        {
          myTree.appendItem(topid,newid,&quot;.&quot;+parts[j]);
          if(j == dynlen(parts))
          {
            IdList[newid] = 0;
            dynAppend(ids, newid);
            TypeIdList[id] = ids;
            myTree.setIcon(newid,1, &quot;16_ack_check_border1.gif&quot;);
          }
          DebugN(&quot;Appending&quot;, topid, newid, &quot;.&quot;+parts[j]);
        }
        topid = newid;
      }
    }
*/
    if(sys != &quot;&quot;)
      pattern = sys;
    pattern += &quot;*&quot;;
    dps = dpNames(pattern, dpType);
    for(i = 1; i &lt;= dynlen(dps); i++)
    {
      dp = dpSubStr(dps[i],DPSUB_DP);
      if(!myTree.itemExists(sys+dp))
      {
        myTree.appendItem(id,sys+dp, dp);
        myTree.setIcon(sys+dp,0,&quot;dptree/dptype.png&quot;);
//        DebugN(&quot;Appending&quot;, id,sys+dp, dp);
      }
      else if(id == sys+dp)
      {
//DebugN(&quot;Node already exists&quot;, id, &quot;&amp;&quot;+sys+dp, dp);
        myTree.appendItem(id,&quot;&amp;&quot;+sys+dp, dp);
        myTree.setIcon(&quot;&amp;&quot;+sys+dp,0,&quot;dptree/dptype.png&quot;);
      }
    }
  }
  else if(dynlen(items) &gt; 2)
  {
    elitems = strsplit(id,&quot;:.&quot;);
    type = elitems[1]+&quot;:&quot;+elitems[2];
    expandOneLevel(type, id);
  }
}

dyn_string getSystems()
{
  dyn_string names;
  dyn_uint uids;

  getSystemNames(names, uids);
  return names;
}

dyn_string getDpTypes(string sys = &quot;&quot;, int internalDps = 0)
{
  dyn_string types, int_types;
  int id, i;

  if(sys == &quot;&quot;)
    sys = getSystemName();
  id = getSystemId(sys);
  types = dpTypes(&quot;*&quot;, id);
  for(i = 1; i &lt;= dynlen(types); i++)
  {
    if(strpos(types[i],&quot;_&quot;) == 0)
    {
      dynAppend(int_types, types[i]);
      dynRemove(types,i);
      i--;
    }
  }
  if(internalDps)
  {
    dynAppend(int_types, types);
    return int_types;
  }
  return types;
}

string getDpTypeDp(string dpType, string sys = &quot;&quot;)
{
  dyn_string dps;
  string pattern;
  dyn_string dpels, dimtypes;
  string dp;
  int i, found = 0;

  if(sys != &quot;&quot;)
    pattern = sys;
  pattern += &quot;*&quot;;
  dps = dpNames(pattern, dpType);
  for(i = 1; i &lt;= dynlen(dps); i++)
  {
    dp = dpSubStr(dps[i], DPSUB_DP);
//    if(strpos(dp,&quot;_&quot;) != 0)
////      found = 0;
////    else
//    {
      found = 1;
      break;
//    }
  }
  if(found)
  {
//    DebugN(&quot;found&quot;, dp);
    return(dp);
  }
  return(&quot;&quot;);
}

dyn_string getDpTypeStruct(string dpType, string sys = &quot;&quot;, dyn_string &amp;dpels, dyn_string &amp;types)
{
  string dp;

  dynClear(dpels);
  dp = getDpTypeDp(dpType, sys);
//DebugN(&quot;getDpTypeDp&quot;,dpType, sys, dp);
  if(dp != &quot;&quot;)
  {
    get_structure(sys+dp, dpels, types);
//    DebugN(dpType, sys, dp, dpels, types);
  }
//  else
//    DebugN(dpType, sys);
}

get_structure(string dp, dyn_string &amp;dpels, dyn_string &amp;dimtypes)
{
  int i;
  string sys;

  dpels = dpNames(dp+&quot;.**&quot;);
  sys = dpSubStr(dp, DPSUB_SYS);
  for(i = 1; i &lt;= dynlen(dpels); i++)
  {
    dimtypes[i] = getDimDpType(dpElementType(dpels[i]));
    strreplace(dpels[i], sys, &quot;&quot;);
  }
}
